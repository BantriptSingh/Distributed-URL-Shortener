# Copy to .env for local Docker / host-run backend.
# Generate secrets locally, e.g. openssl rand -base64 48 — never commit real values.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shortener
SPRING_DATASOURCE_USERNAME=shortener
SPRING_DATASOURCE_PASSWORD=changeme
REDIS_URL=redis://localhost:6379
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
SEED_DEMO_DATA=false
DEV_EXPOSE_RESET_TOKEN=true

# Required later (M3+). Placeholders only — replace before auth ships to prod.
JWT_SECRET=change-me-access-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-please
IP_HASH_SALT=change-me-ip-salt-min-16
UNLOCK_TOKEN_SECRET=change-me-unlock-min-32-chars
CLAIM_TOKEN_SECRET=change-me-claim-min-32-chars
